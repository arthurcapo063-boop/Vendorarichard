# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / Vercel Postgres / local).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── Paystack (payments) ─────────────────────────────────────────────────────
# Both TEST and LIVE key pairs are REQUIRED. The active one is chosen at runtime
# from the Admin Panel → App Settings → "Paystack payments" → Paystack mode
# (toggle Test / Live at any time). Leave the legacy PAYSTACK_SECRET_KEY /
# PAYSTACK_PUBLIC_KEY out unless you're not using the mode toggle.

# TEST keys (sandbox) — used when Paystack mode is "test".
PAYSTACK_TEST_SECRET_KEY="sk_test_..."
PAYSTACK_TEST_PUBLIC_KEY="pk_test_..."

# LIVE keys (real money) — used when Paystack mode is "live".
PAYSTACK_LIVE_SECRET_KEY="sk_live_..."
PAYSTACK_LIVE_PUBLIC_KEY="pk_live_..."

# ── Paystack split payments (subaccount) ───────────────────────────────────
# The percentage of each Paystack payment that stays in YOUR main account.
# The remainder (100 − this) is settled directly to the subaccount configured
# in the Admin Panel → App Settings → "Paystack split payments (3% / 97%)".
# Default 3 ⇒ 3% to you, 97% to the subaccount. Leave empty for the default.
PAYSTACK_SUBACCOUNT_PERCENTAGE="3"

# ── Public site URL ────────────────────────────────────────────────────────
# Used for Paystack callback_url when a request has no Origin/Host header
# (e.g. production). Example: https://shop.example.com
NEXT_PUBLIC_SITE_URL=""
